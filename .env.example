# Product — which product this deployment serves (doldadress | serus).
# One codebase, one deploy + database per product. Both vars must match;
# NEXT_PUBLIC_PRODUCT is what reaches the browser (branding). Defaults to
# "doldadress" when unset. See ADD_NEW_PRODUCT.md.
PRODUCT="doldadress"
NEXT_PUBLIC_PRODUCT="doldadress"

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/doldadress"

# Security - Encryption Key for Credentials (generate with: openssl rand -hex 32)
ENCRYPTION_KEY="generate-with-openssl-rand-hex-32"

# Anthropic (Claude) — used for customer response generation
ANTHROPIC_API_KEY="sk-ant-..."

# OpenAI — used only by batch import scripts (KB ingestion, etc.)
OPENAI_API_KEY="sk-..."

# Stripe
STRIPE_API_KEY="sk_live_..."

# Billecta
BILLECTA_API_KEY="your_billecta_api_key"
BILLECTA_CREDITOR_ID="your_creditor_public_id"

# Resend
RESEND_API_KEY="re_..."
RESEND_FROM_EMAIL="support@doldadress.com"

# Retool (Workflow). API-nyckeln skickas som X-Workflow-Api-Key, e-posten POST:as
# i body ({ "email": "..." }). Konfigureras normalt per tenant via Inställningar.
RETOOL_API_KEY="your_retool_workflow_api_key"
RETOOL_WORKFLOW_URL="https://api.retool.com/v1/workflows/<workflow-id>/startTrigger"

# NextAuth
NEXTAUTH_URL="http://localhost:3001"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"

# Google OAuth (for Sign in with Google and Gmail inbox)
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_OAUTH_BASE_URL="https://doldadress.successifier.com"  # Set to your Vercel URL for production
