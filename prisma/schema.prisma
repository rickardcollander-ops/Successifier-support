generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id        String   @id @default(cuid())
  subdomain String   @unique
  name      String
  // Per-tenant configuration (branding, language, agents, signatures,
  // integrations, sign-in allowlists…). Partial TenantConfig JSON — anything
  // missing falls back to the platform defaults (lib/products/defaults.ts)
  // and, for the legacy launch customers, their code preset. Editable at
  // runtime via the superadmin tenant API, no redeploy needed.
  settings  Json?

  // --- Platform billing (OUR revenue, distinct from the tenant's own
  // Stripe integration used to look up THEIR customers). Managed by the
  // superadmin UI and the platform Stripe webhook. ---
  // 'trial' | 'starter' | 'pro' | 'custom'
  plan          String    @default("trial")
  // 'trialing' | 'active' | 'past_due' | 'canceled' | 'suspended'
  billingStatus String    @default("trialing")
  // When the free trial ends. A trialing tenant past this date is blocked
  // (lib/billing.ts) until a subscription is activated.
  trialEndsAt   DateTime?
  // References into OUR platform Stripe account.
  stripeCustomerId     String? @unique
  stripeSubscriptionId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tickets        Ticket[]
  knowledge      KnowledgeBase[]
  integrations   Integration[]
  agents         Agent[]
  users          User[]
  apiKeys        ApiKey[]
  blockedSenders BlockedSender[]
  kbCategories   KnowledgeCategory[]
  kbEvents       KnowledgeEvent[]
  helpCenter     HelpCenterConfig?
  reportSettings ReportSettings?
  inboxTabs      InboxTab[]
  ticketEvents   TicketEvent[]
  workSessions   AgentWorkSession[]
  csatResponses  CsatResponse[]
  knowledgeCards KnowledgeCard[]
  cardConflicts  KnowledgeCardConflict[]
}

// Per-tenant configuration of the inbox tabs (folders) shown on the tickets
// page. When a tenant has no rows here the UI falls back to the built-in
// default set. Built-in tabs (status/folder views like "Nya", "Akut",
// vendor folder…) are stored with their stable `key` and may be hidden,
// renamed and reordered. Custom tabs (isCustom = true) carry a `rules`
// payload that the inbox evaluates client-side to decide which tickets
// belong in them.
model InboxTab {
  id        String   @id @default(cuid())
  tenantId  String
  // Stable identifier: a built-in folder id ("new", "in_progress", "review",
  // "sent", "closed", "all", "urgent", "billecta", "bounce", "duplicate",
  // "archived") or, for custom tabs, a generated slug.
  key       String
  label     String
  order     Int      @default(0)
  visible   Boolean  @default(true)
  isCustom  Boolean  @default(false)
  // Custom-tab matcher, e.g.
  //   { "match": "all", "conditions": [
  //       { "field": "status",   "op": "in",       "value": ["new","in_progress"] },
  //       { "field": "sender",   "op": "contains", "value": "stripe.com" },
  //       { "field": "subject",  "op": "contains", "value": "refund" },
  //       { "field": "priority", "op": "in",       "value": ["urgent","high"] }
  //   ] }
  rules     Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, key])
  @@index([tenantId])
}

// Tenant-level knobs for the value/ROI reporting: what an agent costs and
// the "before the tool" baselines everything is compared against. Kept in
// its own 1:1 table (same pattern as HelpCenterConfig) so the hot Ticket
// path stays lean.
model ReportSettings {
  id        String   @id @default(cuid())
  tenantId  String   @unique
  // Fully-loaded cost of one support agent per hour, in SEK. Drives the
  // "money saved" estimate. Null = not configured (the UI then asks for it
  // instead of inventing a number).
  agentHourlyCost Float?
  // Historical "before our tool" baselines, e.g. imported from the Zendesk
  // era. When set they are the comparison point for response/handling time.
  // Null = fall back to the in-app "skrev om / utan AI" group as the
  // implicit baseline.
  baselineResponseHours   Float?
  baselineHandlingMinutes Float?
  // SLA target for the FIRST reply to a ticket, in calendar hours (a
  // deliberate simplification — no business-hours calendar; matches how the
  // response-time metrics are computed). Null = SLA panel hidden and the UI
  // prompts for a target instead of assuming one.
  slaFirstResponseHours Float?
  // Staffing-model knobs for the bemanning page. Occupancy = share of a
  // rostered hour an agent realistically spends on tickets; shrinkage =
  // share of rostered time lost to breaks/meetings/absence. Null = the
  // app-side defaults (0.80 / 0.10) apply.
  staffingOccupancy Float?
  staffingShrinkage Float?
  // Scheduled email digest + proactive SLA alerts (sent by the cron routes
  // in app/api/cron/*). digestFrequency: 'weekly' | 'monthly' | null = off.
  // digestLastSentAt makes the daily cron idempotent — a re-fired run sees
  // it already sent this period and does nothing.
  digestFrequency  String?
  digestRecipients String[]  @default([])
  slaAlertsEnabled Boolean   @default(false)
  alertRecipients  String[]  @default([])
  digestLastSentAt DateTime?
  // Append the one-click 👍/👎 CSAT footer to outgoing replies (send route).
  // Requires CSAT_TOKEN_SECRET and APP_BASE_URL to be configured.
  csatEnabled      Boolean   @default(false)
  // Öppettider per weekday: JSON array of 7 entries (Monday = 0), each
  // { open, close } in whole hours (close exclusive) or null = closed day
  // (see lib/business-hours.ts). Null column = not configured → staffing
  // and SLA behave as 24/7 (calendar time), exactly as before this field
  // existed.
  businessHours Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

// One-click customer satisfaction rating from the signed 👍/👎 links in
// outgoing replies (lib/csat-token.ts + /api/public/csat). ONE row per
// ticket — a second click flips the rating via upsert instead of stacking
// duplicate votes.
model CsatResponse {
  id        String   @id @default(cuid())
  tenantId  String
  ticketId  String   @unique
  rating    String   // 'positive' | 'negative'
  comment   String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
}

model Agent {
  id        String   @id @default(cuid())
  email     String
  name      String
  role      String   @default("agent")
  tenantId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([email, tenantId])
  @@index([tenantId])
}

model Ticket {
  id              String   @id @default(cuid())
  tenantId        String
  customerEmail   String
  customerName    String?
  subject         String
  status          String   @default("new")
  priority        String   @default("normal")
  originalMessage String   @db.Text
  aiResponse      String?  @db.Text
  aiConfidence    Float?
  finalResponse   String?  @db.Text
  contextData     Json?
  assignedTo      String?
  sentBy          String?
  sentAt          DateTime?
  // Bumped by the raw-SQL writes (AI drafts, context refresh) that
  // deliberately skip @updatedAt so the list order stays stable. The
  // delta poll uses MAX(updatedAt, contentRefreshedAt) as "changed since".
  contentRefreshedAt DateTime?
  // First moment an agent starts working on the ticket: it leaves the
  // unworked "new" state or first gets assigned. Reports use this to show
  // average active handling time (work time) per ticket — sentAt minus
  // workStartedAt — which is distinct from response time (createdAt → sentAt,
  // wall-clock including time the ticket sat untouched).
  workStartedAt   DateTime?
  // Accumulated seconds an agent was actively present on this ticket, summed
  // from the 5s presence heartbeats (gaps over the stale window are not
  // counted). This is real "time inside the ticket", distinct from the
  // elapsed workStartedAt → sentAt span which also covers time the ticket
  // just sat open while the agent did other things.
  activeWorkSeconds Int    @default(0)
  // What the customer's question is about, from the product's fixed category
  // list (lib/products/*.ts ticketCategories) — AI-classified at creation by
  // lib/services/ticket-classifier.ts. Null = not (yet) categorised; reports
  // show those as "Okategoriserat" rather than hiding them.
  category        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  events TicketEvent[]
  csat   CsatResponse?

  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@index([tenantId, updatedAt])
  @@index([tenantId, assignedTo])
  @@index([tenantId, sentBy])
  @@index([tenantId, category])
}

// Append-only ticket activity log — the structured history the Ticket row
// itself can't provide (sentAt/sentBy are overwritten on every reply, and
// status changes leave no trace). Written by every code path that mutates
// status/assignedTo or sends/receives a message (see lib/services/
// ticket-events.ts). Population filtering (vendor/bounce/Zendesk) is done on
// the READ side by joining the Ticket — never at write time — so report
// queries stay consistent with the inbox rules however those evolve.
model TicketEvent {
  id       String @id @default(cuid())
  tenantId String
  ticketId String
  // 'created' | 'inbound_received' | 'status_changed' | 'assigned' |
  // 'reply_sent' | 'work_started' (see TICKET_EVENT in ticket-events.ts)
  type     String
  // Canonical agent name (via resolveAgentName), or a system actor:
  // 'system' | 'gmail-sync' | 'api' | 'backfill'.
  actor    String?
  // status_changed / assigned: previous and new value.
  fromValue String?
  toValue   String?
  // reply_sent only: seconds from the latest prior inbound message (or the
  // ticket's creation) to this reply — the per-reply response time.
  responseSeconds Int?
  meta            Json?
  // Set explicitly for backfilled events and events anchored to the mail's
  // real arrival time (receivedAt); otherwise the insert time.
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([tenantId, type, createdAt])
  @@index([ticketId, createdAt])
}

// DB-persisted agent presence sessions, accrued from the same 5s heartbeats
// that feed Ticket.activeWorkSeconds (see app/api/tickets/presence/route.ts).
// Unlike the in-memory viewers map (which stays for the live "who is
// viewing" UI) these rows survive restarts and multiple serverless
// instances, giving the bemanning page real "hours worked" per weekday/hour.
// A session is one contiguous stretch of heartbeats on one ticket; a gap
// longer than the active window, or a switch to another ticket, starts a
// new row.
model AgentWorkSession {
  id         String  @id @default(cuid())
  tenantId   String
  agentEmail String
  // Canonical agent name via resolveAgentName; null when the email doesn't
  // match a known agent.
  agentName String?
  ticketId  String?
  startedAt  DateTime
  lastSeenAt DateTime
  seconds    Int      @default(0)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, agentEmail, lastSeenAt])
  @@index([tenantId, startedAt])
}

model KnowledgeBase {
  id        String   @id @default(cuid())
  tenantId  String
  title     String
  content   String   @db.Text
  category  String?
  tags      String[]
  // isActive controls whether the AI may use the article (unchanged meaning).
  isActive  Boolean  @default(true)

  // --- Public help center fields (separate from AI visibility) ---
  // Clean URL slug, unique per tenant. Backfilled from the title.
  slug       String?
  // Whether the article is shown in the public help center. ALWAYS false
  // for auto-learned articles (they contain customer PII).
  isPublic   Boolean  @default(false)
  // Editorial workflow: 'draft' | 'review' | 'published'.
  status     String   @default("draft")
  // Short summary for lists / SEO.
  excerpt    String?
  // Manually picked "see also" article ids.
  relatedIds String[] @default([])
  // Manual ordering within the help center.
  sortOrder  Int      @default(0)
  // Fast denormalized view counter (detailed log lives in KnowledgeEvent).
  viewCount  Int      @default(0)
  // Structured category (optional; legacy free-text `category` kept for AI).
  categoryId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant    Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  kbCategory KnowledgeCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  revisions KnowledgeRevision[]

  @@index([tenantId, isActive])
  @@index([tenantId, category])
  @@index([tenantId, isPublic, status])
  @@unique([tenantId, slug])
}

// Structured, public-facing categories for the help center. The legacy
// free-text KnowledgeBase.category is kept for backwards compatibility and
// the AI keyword rerank; this model powers the browsable help center.
model KnowledgeCategory {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  slug        String
  description String?
  icon        String?
  sortOrder   Int      @default(0)
  isPublic    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant   Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  articles KnowledgeBase[]

  @@unique([tenantId, slug])
  @@index([tenantId])
}

// A snapshot of an article's content, written on every edit so changes can
// be audited and restored.
model KnowledgeRevision {
  id        String   @id @default(cuid())
  articleId String
  title     String
  content   String   @db.Text
  excerpt   String?
  editedBy  String?
  createdAt DateTime @default(now())

  article KnowledgeBase @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([articleId, createdAt])
}

// A knowledge card is a knowledge IDENTITY: one question customers keep
// asking, one currently-accepted answer, and every sent reply that confirmed
// it. It replaces the old auto-learning in tickets/[id]/send, which wrote a
// fresh KnowledgeBase article per sent reply (matched only on the first 50
// chars of the subject), never merged them and never noticed when two
// replies said opposite things — so the pile was pruned after 30 days
// instead of being reconciled.
//
// The lifecycle is driven by lib/services/knowledge-cards.ts: a sent reply
// either confirms an existing card, contradicts it (raising a
// KnowledgeCardConflict for human review) or becomes a new card.
model KnowledgeCard {
  id       String @id @default(cuid())
  tenantId String
  // The canonical phrasing of the question, normalised when the card is
  // created so repeated wordings of the same question land on one card.
  question String @db.Text
  // The currently accepted answer. Fed to the AI generator when the card is
  // 'active'; never overwritten silently once an agent has curated it.
  answer   String @db.Text
  category String?
  tags     String[]
  // 'active'   — trusted; used for AI grounding.
  // 'review'   — an open conflict makes the answer untrustworthy, so the
  //              card is withheld from grounding until an agent resolves it.
  // 'archived' — retired by an agent; never used.
  status   String @default("active")
  // How many sent replies have agreed with this answer, and when the most
  // recent one did. Both feed ranking: a card confirmed twenty times last
  // week is worth more than one confirmed once a year ago.
  confirmedCount  Int      @default(1)
  lastConfirmedAt DateTime @default(now())
  // Set when an agent edits the answer by hand. A curated answer is never
  // replaced automatically — a contradicting reply raises a conflict
  // instead, so human judgement is not silently undone by a helper model.
  curatedAt DateTime?
  curatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant    Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sources   KnowledgeCardSource[]
  conflicts KnowledgeCardConflict[]

  @@index([tenantId, status])
  @@index([tenantId, lastConfirmedAt])
}

// One sent reply that supports a card's answer — the provenance trail that
// lets an agent ask "why does the system believe this?" and read the actual
// tickets behind it. Deliberately stores no customer email or body: the
// subject is enough to find the ticket, and these rows are read while
// looking at knowledge shared across customers.
model KnowledgeCardSource {
  id       String @id @default(cuid())
  cardId   String
  ticketId String
  subject  String
  // 'created'   — this reply established the card.
  // 'confirmed' — it later agreed with the card's answer.
  // 'contested' — it contradicted the card and raised a conflict. Kept as a
  //               source anyway: the ticket is part of the card's history
  //               and is exactly what an agent wants to open when judging
  //               the disagreement.
  role     String @default("confirmed")
  sentAt   DateTime @default(now())

  card KnowledgeCard @relation(fields: [cardId], references: [id], onDelete: Cascade)

  // A ticket supports a given card once, however many times it is processed.
  @@unique([cardId, ticketId])
  @@index([cardId, sentAt])
}

// A detected contradiction between a card's accepted answer and what an
// agent just sent to a customer. Never resolved automatically: the whole
// point is that a human decides which version is true, because picking
// wrong here poisons every future AI answer on the topic.
model KnowledgeCardConflict {
  id       String @id @default(cuid())
  tenantId String
  cardId   String
  // The ticket whose reply contradicted the card, for "see where this came
  // from" in the review queue.
  ticketId String
  subject  String
  // Snapshot of the card's answer AT DETECTION TIME. Kept verbatim rather
  // than read live from the card, so the review queue keeps showing the two
  // versions that actually disagreed even if the card moves on.
  currentAnswer  String @db.Text
  proposedAnswer String @db.Text
  // The helper model's one-sentence account of what contradicts what. Shown
  // to the agent as a hint, never as the deciding vote.
  reason String @db.Text
  // 'open' | 'resolved' | 'dismissed'
  status String @default("open")
  // How it was settled: 'kept_current' | 'accepted_proposed' | 'merged'.
  resolution   String?
  // The answer the agent settled on — what the card carries afterwards.
  resolvedAnswer String? @db.Text
  resolvedBy     String?
  resolvedAt     DateTime?
  createdAt      DateTime @default(now())

  tenant Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  card   KnowledgeCard @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@index([tenantId, status, createdAt])
  @@index([cardId, createdAt])
}

// Per-tenant appearance of the public help center. One row per deployment;
// all fields have sensible defaults so the help center works before it's ever
// configured.
model HelpCenterConfig {
  id          String   @id @default(cuid())
  tenantId    String   @unique
  accentColor String   @default("#7C5CFF")
  theme       String   @default("light") // 'light' | 'dark' | 'auto'
  logoUrl     String?
  headline    String?
  intro       String?
  layout      String   @default("grid") // 'grid' | 'list'
  showSearch  Boolean  @default(true)
  // Extra appearance
  footerText   String?
  supportUrl   String?
  supportLabel String?
  // Chatbot
  chatEnabled      Boolean  @default(true)
  chatTitle        String?
  chatWelcome      String?
  chatPlaceholder  String?
  chatInstructions String?  // operator-authored persona/tone added to the system prompt
  chatFallback     String?  // message shown when the KB can't answer
  chatSuggestions  String[] @default([]) // starter questions shown as chips
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

// Raw usage events powering help-center analytics (views, searches, helpful
// votes). Kept append-only and aggregated on read.
model KnowledgeEvent {
  id           String   @id @default(cuid())
  tenantId     String
  type         String   // 'view' | 'search' | 'helpful' | 'unhelpful'
  articleId    String?
  query        String?
  resultsCount Int?
  createdAt    DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, type, createdAt])
  @@index([articleId])
}

model AIResponseFeedback {
  id                String   @id @default(cuid())
  tenantId          String
  ticketId          String
  customerEmail     String
  subject           String
  originalMessage   String   @db.Text
  aiResponse        String   @db.Text
  finalResponse     String?  @db.Text
  wasEdited         Boolean  @default(false)
  rating            String?  // 'positive', 'negative', null
  editedBy          String?  // User who edited
  contextUsed       Json?    // What context was available (billecta, stripe, etc)
  knowledgeUsed     String[] // Which KB articles were used
  createdAt         DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([tenantId, rating])
  @@index([customerEmail])
}

// Email addresses (or domains, with a leading "@") whose incoming mail
// should be silently dropped by the Gmail sync. Used to filter persistent
// spam senders without having to delete tickets one by one.
model BlockedSender {
  id        String   @id @default(cuid())
  tenantId  String
  pattern   String   // e.g. "spam@example.com" or "@spamdomain.com"
  reason    String?
  createdBy String?
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, pattern])
  @@index([tenantId])
}

model Integration {
  id          String   @id @default(cuid())
  tenantId    String
  type        String
  name        String
  credentials Json
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, type])
  @@index([tenantId])
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  role          String    @default("agent")
  tenantId      String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  emailAccounts EmailAccount[]
  tenant        Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model EmailAccount {
  id            String   @id @default(cuid())
  userId        String
  email         String
  provider      String   @default("google")
  accessToken   String   @db.Text
  refreshToken  String   @db.Text
  expiresAt     DateTime?
  isActive      Boolean  @default(true)
  lastSyncAt    DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, email])
  @@index([userId])
  @@index([isActive])
}

model ApiKey {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  // SHA-256 hash of the key. The plaintext is only shown once at creation.
  key         String   @unique
  // Display form ("dold_abc…wxyz") so the UI can identify keys in lists.
  maskedKey   String?
  lastUsedAt  DateTime?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([key])
}
