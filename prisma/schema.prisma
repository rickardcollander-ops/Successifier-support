generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id        String   @id @default(cuid())
  subdomain String   @unique
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tickets        Ticket[]
  knowledge      KnowledgeBase[]
  integrations   Integration[]
  agents         Agent[]
  users          User[]
  apiKeys        ApiKey[]
  blockedSenders BlockedSender[]
  kbCategories   KnowledgeCategory[]
  kbEvents       KnowledgeEvent[]
}

model Agent {
  id        String   @id @default(cuid())
  email     String
  name      String
  role      String   @default("agent")
  tenantId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([email, tenantId])
  @@index([tenantId])
}

model Ticket {
  id              String   @id @default(cuid())
  tenantId        String
  customerEmail   String
  customerName    String?
  subject         String
  status          String   @default("new")
  priority        String   @default("normal")
  originalMessage String   @db.Text
  aiResponse      String?  @db.Text
  aiConfidence    Float?
  finalResponse   String?  @db.Text
  contextData     Json?
  assignedTo      String?
  sentBy          String?
  sentAt          DateTime?
  // Bumped by the raw-SQL writes (AI drafts, context refresh) that
  // deliberately skip @updatedAt so the list order stays stable. The
  // delta poll uses MAX(updatedAt, contentRefreshedAt) as "changed since".
  contentRefreshedAt DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@index([tenantId, updatedAt])
  @@index([tenantId, assignedTo])
  @@index([tenantId, sentBy])
}

model KnowledgeBase {
  id        String   @id @default(cuid())
  tenantId  String
  title     String
  content   String   @db.Text
  category  String?
  tags      String[]
  // isActive controls whether the AI may use the article (unchanged meaning).
  isActive  Boolean  @default(true)

  // --- Public help center fields (separate from AI visibility) ---
  // Clean URL slug, unique per tenant. Backfilled from the title.
  slug       String?
  // Whether the article is shown in the public help center. ALWAYS false
  // for auto-learned articles (they contain customer PII).
  isPublic   Boolean  @default(false)
  // Editorial workflow: 'draft' | 'review' | 'published'.
  status     String   @default("draft")
  // Short summary for lists / SEO.
  excerpt    String?
  // Manually picked "see also" article ids.
  relatedIds String[] @default([])
  // Manual ordering within the help center.
  sortOrder  Int      @default(0)
  // Fast denormalized view counter (detailed log lives in KnowledgeEvent).
  viewCount  Int      @default(0)
  // Structured category (optional; legacy free-text `category` kept for AI).
  categoryId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant    Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  kbCategory KnowledgeCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  revisions KnowledgeRevision[]

  @@index([tenantId, isActive])
  @@index([tenantId, category])
  @@index([tenantId, isPublic, status])
  @@unique([tenantId, slug])
}

// Structured, public-facing categories for the help center. The legacy
// free-text KnowledgeBase.category is kept for backwards compatibility and
// the AI keyword rerank; this model powers the browsable help center.
model KnowledgeCategory {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  slug        String
  description String?
  icon        String?
  sortOrder   Int      @default(0)
  isPublic    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant   Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  articles KnowledgeBase[]

  @@unique([tenantId, slug])
  @@index([tenantId])
}

// A snapshot of an article's content, written on every edit so changes can
// be audited and restored.
model KnowledgeRevision {
  id        String   @id @default(cuid())
  articleId String
  title     String
  content   String   @db.Text
  excerpt   String?
  editedBy  String?
  createdAt DateTime @default(now())

  article KnowledgeBase @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([articleId, createdAt])
}

// Raw usage events powering help-center analytics (views, searches, helpful
// votes). Kept append-only and aggregated on read.
model KnowledgeEvent {
  id           String   @id @default(cuid())
  tenantId     String
  type         String   // 'view' | 'search' | 'helpful' | 'unhelpful'
  articleId    String?
  query        String?
  resultsCount Int?
  createdAt    DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, type, createdAt])
  @@index([articleId])
}

model AIResponseFeedback {
  id                String   @id @default(cuid())
  tenantId          String
  ticketId          String
  customerEmail     String
  subject           String
  originalMessage   String   @db.Text
  aiResponse        String   @db.Text
  finalResponse     String?  @db.Text
  wasEdited         Boolean  @default(false)
  rating            String?  // 'positive', 'negative', null
  editedBy          String?  // User who edited
  contextUsed       Json?    // What context was available (billecta, stripe, etc)
  knowledgeUsed     String[] // Which KB articles were used
  createdAt         DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([tenantId, rating])
  @@index([customerEmail])
}

// Email addresses (or domains, with a leading "@") whose incoming mail
// should be silently dropped by the Gmail sync. Used to filter persistent
// spam senders without having to delete tickets one by one.
model BlockedSender {
  id        String   @id @default(cuid())
  tenantId  String
  pattern   String   // e.g. "spam@example.com" or "@spamdomain.com"
  reason    String?
  createdBy String?
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, pattern])
  @@index([tenantId])
}

model Integration {
  id          String   @id @default(cuid())
  tenantId    String
  type        String
  name        String
  credentials Json
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, type])
  @@index([tenantId])
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  role          String    @default("agent")
  tenantId      String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  emailAccounts EmailAccount[]
  tenant        Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model EmailAccount {
  id            String   @id @default(cuid())
  userId        String
  email         String
  provider      String   @default("google")
  accessToken   String   @db.Text
  refreshToken  String   @db.Text
  expiresAt     DateTime?
  isActive      Boolean  @default(true)
  lastSyncAt    DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, email])
  @@index([userId])
  @@index([isActive])
}

model ApiKey {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  // SHA-256 hash of the key. The plaintext is only shown once at creation.
  key         String   @unique
  // Display form ("dold_abc…wxyz") so the UI can identify keys in lists.
  maskedKey   String?
  lastUsedAt  DateTime?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([key])
}
